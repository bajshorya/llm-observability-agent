node_modules/
dist/
*.tsbuildinfo

# Local database — regenerate with `pnpm db:push`
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Secrets — never commit real keys
.env
.env.local
.env.*.local

.DS_Store
*.log

# Local editor/tool settings — machine-specific
.claude/settings.local.json
.vscode/
.idea/

# Scratch databases from scripts/capture-cases.sh
.tmp/

# Generated target repository for Phase 3 correlation — a real git repo with a
# nested .git, rebuilt deterministically by scripts/build-fixture-repo.sh
fixtures/orders-api/

# Next.js build output
.next/
next-env.d.ts

# Working documentation — kept on disk, out of the repository.
# README.md is the only exception and stays tracked; the negation below must
# come after the blanket rule to take effect.
*.md
!README.md
