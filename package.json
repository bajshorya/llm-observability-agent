{
  "name": "observability-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "backend": "pnpm --filter @obs/backend dev",
    "generate": "pnpm --filter @obs/generator start",
    "detect": "pnpm --filter @obs/backend detect",
    "classify": "pnpm --filter @obs/backend classify",
    "test": "pnpm -r test",
    "db:push": "pnpm --filter @obs/backend db:push",
    "db:studio": "pnpm --filter @obs/backend db:studio",
    "typecheck": "pnpm -r exec tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
