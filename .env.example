# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#
# Every value has a working default. With this file copied unchanged, every
# command runs offline against the stub — no key, no network, no quota.
# Leave a line empty (KEY=) to use its default.

# ---- Backend ----------------------------------------------------------------
PORT=4000
# SQLite. Relative paths resolve from the repo root, not the current directory.
# The schema is created and migrated automatically the first time any command
# opens the file. To move to Postgres, swap the Drizzle driver in
# packages/backend/src/db/client.ts.
DATABASE_URL=file:./data/dev.db

# Retention, in days. Raw logs are the bulk of the database; rollups are small
# and feed the charts. Verdicts, correlations and alerts are never deleted.
# 0 keeps forever. `pnpm watch` applies this hourly; `pnpm retention` once.
LOG_RETENTION_DAYS=14
ROLLUP_RETENTION_DAYS=90

# ---- Log generator and @obs/client ------------------------------------------
INGEST_URL=http://localhost:4000/ingest

# When set, POST /ingest requires `Authorization: Bearer <this>`. Empty means
# ingest is open — fine on a laptop; set it before the port is reachable from
# anywhere else. The generator reads it from this file; pass it to @obs/client
# as `apiKey`. Any long random string: openssl rand -hex 32
INGEST_API_KEY=

# ---- LLM provider -----------------------------------------------------------
# Which provider classify, correlate and diagnose call:
#   gemini | nvidia | openrouter | ollama | stub
# `stub` is deterministic, needs no key and runs offline; it is also the
# statistical baseline every tier is measured against. Set `gemini` (with
# GEMINI_API_KEY below) to have a real model judge anomalies.
LLM_PROVIDER=stub

# Overrides the provider's default model (packages/backend/src/llm/config.ts).
# Gemini's default is gemini-3.5-flash. Free-tier quotas are PER MODEL, so this
# is also the way through a 429 once one model's daily quota is spent.
LLM_MODEL=

# Google AI Studio, free tier, no credit card: https://aistudio.google.com/apikey
# Free tier: 5 requests/minute and 20/day, per model.
GEMINI_API_KEY=

# NVIDIA NIM, free developer tier: https://build.nvidia.com
NVIDIA_API_KEY=

# OpenRouter, free :free model variants: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama runs locally, no key needed. Its default model is llama3.1:8b, which
# may not be installed — `ollama list` shows what is; set LLM_MODEL to match.
OLLAMA_BASE_URL=http://localhost:11434

# Sampling temperature. Empty means the default, 0.1; set it only to measure
# eval repeatability (LLM_TEMPERATURE=0).
LLM_TEMPERATURE=

# ---- Commit correlation (Phase 3) and root cause (Phase 4) ------------------
# The git checkout incidents are correlated against. The default is the
# generated fixture: bash scripts/build-fixture-repo.sh
# Point it at your service's own checkout to correlate against real history.
TARGET_REPO_PATH=./fixtures/orders-api

# Include diff hunks in the correlation packet. Off by default: measured to
# help some models decline and to hurt others — see CLAUDE.md before enabling.
CORRELATION_DIFFS=0

# ---- Alerting (pnpm alert, pnpm watch) --------------------------------------
# With both empty, alerts print to the terminal instead of being sent.
# Slack incoming webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# Any endpoint that accepts a JSON POST (PagerDuty bridge, Discord, your own).
ALERT_WEBHOOK_URL=
# Lowest Tier 2 severity that pages: low | medium | high | critical.
# Silence alerts ignore this — no model rates them.
ALERT_MIN_SEVERITY=high
# Where alert links point.
DASHBOARD_URL=http://localhost:3000
