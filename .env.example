# Copy to .env and fill in. Never commit .env.

# ---- Backend ----
PORT=4000
# SQLite for now. To move to Postgres, swap the Drizzle driver in
# packages/backend/src/db/client.ts and point this at a connection string.
DATABASE_URL=file:./data/dev.db

# ---- Log generator ----
INGEST_URL=http://localhost:4000/ingest

# ---- LLM providers (Phase 2 — not needed yet) ----
# Which provider the agents use: gemini | nvidia | openrouter | ollama | stub
LLM_PROVIDER=stub

# Google AI Studio, free tier, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# NVIDIA NIM, free developer tier: https://build.nvidia.com
NVIDIA_API_KEY=

# OpenRouter, free :free model variants: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama runs locally, no key needed
OLLAMA_BASE_URL=http://localhost:11434

# ---- GitHub (Phase 3 — not needed yet) ----
# Read-only personal access token with `repo` scope, for commit correlation
GITHUB_TOKEN=
GITHUB_REPO=owner/name
